From 2ec2449ca848de1229cc85495e1ea2210d47606c Mon Sep 17 00:00:00 2001
From: lcwang <lcwang@ieiworld.com>
Date: Tue, 27 Jan 2026 18:11:18 +0800
Subject: [PATCH 1/1] arm64: dts: rk3588-b675: disable hdmi and lvds displays

---
 arch/arm64/boot/dts/rockchip/rk3588-b675.dts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-b675.dts b/arch/arm64/boot/dts/rockchip/rk3588-b675.dts
index 7a4bb47d0141..cd40f0cbb60d 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-b675.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-b675.dts
@@ -655,7 +655,7 @@ &pwm13 {
  * when dsi1 is enabled
  */
 &dsi1 {
-	status = "okay";
+	status = "disabled";
 };
 
 &dsi1_in_vp2 {
@@ -769,7 +769,7 @@ &gmac1_rgmii_bus
 
 &hdmi0 {
 	enable-gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
-	status = "okay";
+	status = "disabled";
 };
 
 &hdmi0_in_vp0 {
@@ -782,7 +782,7 @@ &hdmi0_sound {
 
 &hdmi1 {
 	enable-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
-	status = "okay";
+	status = "disabled";
 };
 
 &hdmi1_in_vp1 {
-- 
2.34.1

